#version 450
#extension GL_EXT_control_flow_attributes : require
// Frame generation: motion vectors, by symmetric block matching around the frame halfway between the two (a vector v
// at x matches prev(x - v/2) with cur(x + v/2)), so the in-between frame needs no splatting and has no holes.
// A cell's cost is the sum of absolute luma differences over a 4x4 patch of luma texels around its centre (bilinear:
// vectors are sub-texel), less their mean (fades and flashes still match), plus a small pull towards the predicted
// vector, so flat areas keep their neighbours' motion.
// Mode 0 (coarsest level): every whole-texel vector within +-radius, and the last frame's vector. Mode 1: the coarser
// field's vectors at this cell and its four neighbours, zero and the last frame's. Mode 2 (a last refinement on the
// same grid): the cell's own vector, zero and the last frame's. Then the best is refined by steps of `first` luma
// texels, halved down to `last`, unless its cost is already below b.w (a match that good leaves nothing to refine:
// still areas, flat ones, and steady motion the last frame's vector predicts). Vectors are in pixels of the full
// image; out: (vector, cost, mean luma change).
// Luma and costs are mediump (Adreno: half registers, double-rate ALU); positions stay highp (a 1/4 luma is 500+
// texels wide, more than fp16 resolves to a fraction of a texel).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform mediump sampler2D lprev;
layout(set = 0, binding = 1) uniform mediump sampler2D lcur;
layout(set = 0, binding = 2) uniform sampler2D coarse;    // mode 1: the coarser field
layout(set = 0, binding = 3) uniform sampler2D temporal;  // the last frame's final field
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec4 size;  // x: mode (0, 1, 2), y: radius (mode 0), z: the last frame's field is valid
    vec4 a;      // full pixels per: x a cell of this field, y a luma texel, z a coarser cell, w a temporal cell
    vec4 b;      // x: the first refinement step, y: the last (luma texels); z: 1 = 2x2 taps; w: the cost that ends it
} p;

vec2 inv, lsize;
vec2 lc;  // the cell's centre in luma texels
float lscale;
vec2 pred;
vec2 best_v;
mediump float best_c;

bool coarse_taps;
mediump float dmean, best_dm;  // the patch's mean luma change (cur - prev): a fade, which the cost leaves out

// Mean-removed: the differences' spread around their mean, so a fade or a flash still matches. Fixed loop bounds
// (unrolled: the values stay in registers): with the patch size chosen at run time the array was indexed dynamically,
// and Adreno's compiler kept it in memory (the search took ~3 ms a frame on an Adreno 650).
mediump float sad4(vec2 h) {  // the same 4x4 texels as 2x2 bilinear taps (means of 2x2), a quarter of the samples
    mediump float d[4];
    mediump float m = 0.0;
    [[unroll]] for (int k = 0; k < 4; k++) {
        vec2 o = vec2(float(k & 1) * 2.0 - 1.0, float(k >> 1) * 2.0 - 1.0);
        d[k] = texture(lcur, (lc + o + h) * inv).r - texture(lprev, (lc + o - h) * inv).r;
        m += d[k];
    }
    m *= 0.25;
    mediump float s = 0.0;
    [[unroll]] for (int k = 0; k < 4; k++) s += abs(d[k] - m);
    dmean = m;
    return s * 4.0;
}

// The 4x4 bilinear taps around `at` (luma texels), all at the same sub-texel phase: their 5x5 texels come in 9 gathers
// and are filtered here, instead of 16 filtered samples (the gathers' third row and column are one texel too wide).
// Bilinear filtering in the ALU is also finer than the sampler's (8-bit weights on most GPUs).
void taps16(mediump sampler2D l, vec2 at, out mediump float o[16]) {
    vec2 f0 = at - 2.0;  // the first tap is at at - 1.5: its left texel's centre is at floor(at - 2) + 0.5
    vec2 i0 = floor(f0);
    mediump vec2 f = f0 - i0;
    mediump float t[6][6];
    [[unroll]] for (int gy = 0; gy < 3; gy++)
        [[unroll]] for (int gx = 0; gx < 3; gx++) {
            // A gather at the corner shared by texels i0 + 2g and i0 + 2g + 1 (on the texel grid's corner: 0.5 texel
            // from either footprint, no rounding can pick another). Components: x (0,1), y (1,1), z (1,0), w (0,0).
            mediump vec4 q = textureGather(l, (i0 + vec2(2 * gx + 1, 2 * gy + 1)) * inv, 0);
            t[2 * gy][2 * gx] = q.w, t[2 * gy][2 * gx + 1] = q.z;
            t[2 * gy + 1][2 * gx] = q.x, t[2 * gy + 1][2 * gx + 1] = q.y;
        }
    mediump float hr[5][4];
    [[unroll]] for (int y = 0; y < 5; y++)
        [[unroll]] for (int x = 0; x < 4; x++) hr[y][x] = mix(t[y][x], t[y][x + 1], f.x);
    [[unroll]] for (int y = 0; y < 4; y++)
        [[unroll]] for (int x = 0; x < 4; x++) o[y * 4 + x] = mix(hr[y][x], hr[y + 1][x], f.y);
}

mediump float sad16(vec2 h) {
    mediump float c[16], pv[16];
    taps16(lcur, lc + h, c);
    taps16(lprev, lc - h, pv);
    mediump float d[16];
    mediump float m = 0.0;
    [[unroll]] for (int k = 0; k < 16; k++) d[k] = c[k] - pv[k], m += d[k];
    m *= 1.0 / 16.0;
    mediump float s = 0.0;
    [[unroll]] for (int k = 0; k < 16; k++) s += abs(d[k] - m);
    dmean = m;
    return s;
}

mediump float sad(vec2 v) {
    vec2 h = 0.5 * v / lscale;
    return coarse_taps ? sad4(h) : sad16(h);
}

void try_v(vec2 v) {
    // The current best again (neighbouring cells in a smooth field, the last frame's vector in steady motion): it
    // would cost the same and not be taken.
    if (v == best_v && best_c < 1e4) return;
    mediump float c = sad(v) + 0.004 * length(v - pred) / lscale;
    if (c < best_c) best_c = c, best_v = v, best_dm = dmean;
}

vec2 fetch(sampler2D f, vec2 full_pos, float fscale, ivec2 off) {
    ivec2 sz = textureSize(f, 0);
    ivec2 q = clamp(ivec2(floor(full_pos / fscale)) + off, ivec2(0), sz - 1);
    return texelFetch(f, q, 0).xy;
}

// The candidates come in order from two try_v call sites (the first ones, then the refinement): each site inlines a
// whole matching (both patch sizes, unrolled), and with one per candidate (16 sites) the code outgrew what Adreno's
// small instruction cache keeps (SPIR-V 210 KB, now 31 KB).
vec2 neighbour(int k, vec2 full) {
    ivec2 off = k == 0 ? ivec2(-1, 0) : k == 1 ? ivec2(1, 0) : k == 2 ? ivec2(0, -1) : ivec2(0, 1);
    return fetch(coarse, full, p.a.z, off);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, imageSize(dst)))) return;
    inv = 1.0 / vec2(textureSize(lprev, 0));
    vec2 full = (vec2(q) + 0.5) * p.a.x;
    lscale = p.a.y;
    coarse_taps = p.b.z != 0.0;
    lc = full / lscale;
    best_c = 6e4;  // fp16-safe "none yet"
    best_v = vec2(0.0);
    best_dm = 0.0;
    int mode = p.size.x;
    bool temporal_ok = p.size.z != 0;
    vec2 tv = temporal_ok ? fetch(temporal, full, p.a.w, ivec2(0)) : vec2(0.0);
    pred = mode == 0 ? vec2(0.0) : fetch(coarse, full, p.a.z, ivec2(0));
    // Mode 0: the (2r+1)^2 whole-texel vectors; modes 1 and 2: the coarser field's (mode 1: and its 4 neighbours')
    // and zero. Then the last frame's.
    int r = p.size.y, side = 2 * r + 1;
    int grid = mode == 0 ? side * side : 0, own = mode == 0 ? 0 : mode == 1 ? 6 : 2;
    [[dont_unroll]] for (int k = 0; k <= grid + own; k++) {
        vec2 v;
        int j = k - grid;
        if (k < grid) v = vec2(k % side - r, k / side - r) * lscale;
        else if (j == own) {
            if (!temporal_ok) break;
            v = tv;
        } else v = j == 0 ? pred : j == 1 ? vec2(0.0) : neighbour(j - 2, full);
        try_v(v);
    }
    // Modes 0 and 1: the first step tries the 8 neighbours, the finer ones a diamond (4). Mode 2: diamonds only.
    for (float step = p.b.x; step >= p.b.y * 0.99 && best_c >= p.b.w; step *= 0.5) {
        vec2 c = best_v;
        int n = step == p.b.x && mode < 2 ? 8 : 4;
        [[dont_unroll]] for (int k = 0; k < n; k++) {
            // +x, -x, +y, -y, then (+,+), (-,-), (+,-), (-,+).
            float sg = (k & 1) == 0 ? 1.0 : -1.0;
            vec2 dir = k < 2 ? vec2(sg, 0.0) : k < 4 ? vec2(0.0, sg) : vec2(sg, k < 6 ? sg : -sg);
            try_v(c + dir * (step * lscale));
        }
    }
    imageStore(dst, q, vec4(best_v, best_c, best_dm));
}
