#version 450
// Frame generation, pass 1: the presented image's luma pyramid levels 1-4 (4x4, 8x8, 16x16 and 32x32 box averages).
// A group covers 32x32 pixels, so it makes exactly one level-4 texel too (a separate pass for it cost a dispatch, a
// barrier and a re-read of level 3). Each invocation makes one level-1 texel from 4 bilinear taps (each the mean of
// 2x2 pixels). Luma is mediump: it is stored as R16F anyway (Adreno then fetches and adds at double rate).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform mediump sampler2D src;
layout(set = 0, binding = 4, r16f) uniform writeonly mediump image2D l4;
layout(set = 0, binding = 5, r16f) uniform writeonly mediump image2D l1;
layout(set = 0, binding = 6, r16f) uniform writeonly mediump image2D l2;
layout(set = 0, binding = 7, r16f) uniform writeonly mediump image2D l3;
layout(push_constant) uniform P {
    ivec4 size;  // xy: the image's size
    vec4 a;
    vec4 b;
} p;

shared mediump float s1[8][8];
shared mediump float s2[4][4];
shared mediump float s3[2][2];

void main() {
    ivec2 t = ivec2(gl_LocalInvocationID.xy), g = ivec2(gl_WorkGroupID.xy);
    ivec2 q1 = g * 8 + t;
    vec2 inv = 1.0 / vec2(p.size.xy), c = vec2(q1 * 4 + 2);
    mediump vec3 sum = texture(src, (c + vec2(-1.0, -1.0)) * inv).rgb + texture(src, (c + vec2(1.0, -1.0)) * inv).rgb +
                       texture(src, (c + vec2(-1.0, 1.0)) * inv).rgb + texture(src, (c + vec2(1.0, 1.0)) * inv).rgb;
    mediump float v = 0.25 * dot(sum, vec3(0.299, 0.587, 0.114));
    s1[t.y][t.x] = v;
    if (all(lessThan(q1, imageSize(l1)))) imageStore(l1, q1, vec4(v));
    barrier();
    if (t.x < 4 && t.y < 4) {
        v = 0.25 * (s1[2 * t.y][2 * t.x] + s1[2 * t.y][2 * t.x + 1] + s1[2 * t.y + 1][2 * t.x] + s1[2 * t.y + 1][2 * t.x + 1]);
        s2[t.y][t.x] = v;
        ivec2 q = g * 4 + t;
        if (all(lessThan(q, imageSize(l2)))) imageStore(l2, q, vec4(v));
    }
    barrier();
    if (t.x < 2 && t.y < 2) {
        v = 0.25 * (s2[2 * t.y][2 * t.x] + s2[2 * t.y][2 * t.x + 1] + s2[2 * t.y + 1][2 * t.x] + s2[2 * t.y + 1][2 * t.x + 1]);
        s3[t.y][t.x] = v;
        ivec2 q = g * 2 + t;
        if (all(lessThan(q, imageSize(l3)))) imageStore(l3, q, vec4(v));
    }
    barrier();
    // Past the right or bottom edge the level-3 texels are of clamped samples (the edge repeated), as the old
    // down pass's clamped reads were.
    if (t.x == 0 && t.y == 0 && all(lessThan(g, imageSize(l4))))
        imageStore(l4, g, vec4(0.25 * (s3[0][0] + s3[0][1] + s3[1][0] + s3[1][1])));
}
