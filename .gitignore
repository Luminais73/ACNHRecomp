# Everything derived from the game, keys and firmware stays local. Never commit.
private/
__pycache__/
*.pyc

# Game dumps must never be committed, wherever they are dropped.
*.xci
*.xci.rar
*.nsp
*.nsz
*.xcz
*.rar
*.keys

# Local tooling state and run logs.
nx.log
*.log
refs/

# Extra guards: anything that can only come from a dump (contents, recompiled code, shaders, builds).
*.nca
*.nso
*.npdm
*.tik
*.cert
*.spv
*.bfsha
*.bntx
*.szs
*.zs
*.sarc
/gen/
/build/
